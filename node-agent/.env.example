# Konfiguracja agenta. Na hypervisorze plik trafia do /etc/virthub-agent/agent.env
# z uprawnieniami 0600 (zawiera sekret współdzielony z control plane).

# --- wymagane ---------------------------------------------------------------
# Token generowany przy rejestracji hypervisora w panelu administratora.
VH_AGENT_TOKEN=zmien-mnie-na-token-z-panelu

# --- tryb pracy -------------------------------------------------------------
# libvirt = maszyny wirtualne KVM (wymaga VT-x/AMD-V)
# lxc     = kontenery przez Incus (działa bez wsparcia sprzętowego)
# mock    = stacja developerska, żadnych prawdziwych maszyn
VH_AGENT_DRIVER=libvirt
VH_LIBVIRT_URI=qemu:///system

# Tylko dla VH_AGENT_DRIVER=lxc: pula dyskowa Incusa i serwer obrazów,
# z którego węzeł sam pobiera szablony kontenerów.
VH_INCUS_POOL=default
VH_INCUS_REMOTE=images

# --- układ katalogów --------------------------------------------------------
VH_IMAGE_DIR=/var/lib/virthub/images
VH_TEMPLATE_DIR=/var/lib/virthub/templates
VH_SEED_DIR=/var/lib/virthub/seeds
VH_STATE_DB=/var/lib/virthub/agent-state.sqlite3

# --- sieć -------------------------------------------------------------------
VH_BRIDGE=br0
# Mostek dla maszyn z adresami z puli NAT — agent zakłada go sam.
VH_NAT_BRIDGE=vhnat0
VH_NFT_TABLE=virthub

# --- konsola ----------------------------------------------------------------
# VNC nasłuchuje tylko lokalnie; dostęp z zewnątrz idzie przez proxy konsoli.
VH_VNC_LISTEN=127.0.0.1

# --- kanał powrotny do control plane ---------------------------------------
VH_CONTROL_PLANE_URL=https://panel.example.com
VH_CALLBACK_SECRET=sekret-callbacku-z-panelu

# --- protokół ---------------------------------------------------------------
VH_MAX_CLOCK_SKEW=300
