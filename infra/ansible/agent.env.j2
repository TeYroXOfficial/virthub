# Zarządzane przez Ansible — ręczne zmiany zostaną nadpisane przy kolejnym wdrożeniu.
# Plik zawiera sekrety współdzielone z panelem: uprawnienia 0640, właściciel root.

VH_AGENT_TOKEN={{ agent_token }}
VH_CALLBACK_SECRET={{ callback_secret }}
VH_CONTROL_PLANE_URL={{ control_plane_url }}

VH_AGENT_DRIVER=libvirt
VH_LIBVIRT_URI=qemu:///system

VH_IMAGE_DIR={{ data_dir }}/images
VH_TEMPLATE_DIR={{ data_dir }}/templates
VH_SEED_DIR={{ data_dir }}/seeds
VH_STATE_DB={{ data_dir }}/agent-state.sqlite3

VH_BRIDGE={{ bridge }}
VH_NFT_TABLE=virthub

# VNC nasłuchuje wyłącznie na loopbacku — dostęp z zewnątrz idzie przez proxy
# konsoli, nigdy bezpośrednio na port hypervisora.
VH_VNC_LISTEN=127.0.0.1

VH_MAX_CLOCK_SKEW=300
